# Copy to .env and fill in the keys you use. .env is gitignored.

# --- Cerebras (main agent model for Experiment 1: ~2000+ tok/s, open models only) ---
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=gpt-oss-120b
# Only other shared-inference model: qwen-3.8-27b (llama3.1-8b was deprecated 2026-05-27)

# --- DeepInfra (page-extraction model; also hosts Claude/Gemini for later experiments) ---
DEEPINFRA_API_KEY=your_deepinfra_api_key_here
DEEPINFRA_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- browser-use page extraction model (separate provider avoids Cerebras per-minute cap) ---
# Leave EXTRACTION_PROVIDER empty to reuse the main model for extraction.
EXTRACTION_PROVIDER=deepinfra
EXTRACTION_MODEL=google/gemma-4-31B-it-turbo

# --- Fast-path small-model step (02_Reasoning_and_Routing): only used when the rules refuse ---
# deepinfra (default, model google/gemma-4-31B-it-turbo), cerebras (gpt-oss-120b) or ollama (local).
# DeepInfra Gemma was the most accurate in the 18-command benchmark; Cerebras is faster but rate-limits.
FASTPATH_PROVIDER=deepinfra
FASTPATH_MODEL=
# Longest to wait for the model (seconds). On timeout the command counts as refused and moves on.
FASTPATH_TIMEOUT=10

# --- Speech-to-text engines (Experiment 3). Put real keys in .env only, never in chat or git. ---
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
# Groq's key (GROQ_API_KEY, below) is also used for its hosted Whisper.

# --- Groq (free tier; capped at 8k tokens/min, too small for browser-use page prompts) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- OpenRouter (optional) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Local Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Benchmark settings (experiments/ only) ---
HEADLESS=false

# --- Jarvis (the finished app at jarvis/, run via run_jarvis.py) ---
# Your name, so Jarvis can greet you by it.
USER_NAME=there
# Brave, launched with your real profile (bookmarks/logins/extensions present) - not a disposable automation
# browser. Defaults below match a standard Windows install; only set these if yours differs. Brave must be
# fully closed before starting Jarvis (Chromium profiles are single-instance-locked).
# BRAVE_EXECUTABLE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
# BRAVE_USER_DATA_DIR=C:\Users\<you>\AppData\Local\BraveSoftware\Brave-Browser\User Data
# BRAVE_PROFILE_DIRECTORY=Default
