# Copy to .env and fill in the keys you use. .env is gitignored.

# --- Cerebras (main agent model for Experiment 1: ~2000+ tok/s, open models only) ---
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=gpt-oss-120b
# Only other shared-inference model: qwen-3.8-27b (llama3.1-8b was deprecated 2026-05-27)

# --- DeepInfra (page-extraction model; also hosts Claude/Gemini for later experiments) ---
DEEPINFRA_API_KEY=your_deepinfra_api_key_here
DEEPINFRA_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- browser-use page extraction model (separate provider avoids Cerebras per-minute cap) ---
# Leave EXTRACTION_PROVIDER empty to reuse the main model for extraction.
EXTRACTION_PROVIDER=deepinfra
EXTRACTION_MODEL=google/gemma-4-31B-it-turbo

# --- Groq (free tier; capped at 8k tokens/min, too small for browser-use page prompts) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- OpenRouter (optional) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Local Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Benchmark settings ---
HEADLESS=false
